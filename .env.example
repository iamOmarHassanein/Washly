# Washly order flow — set these in Vercel → Settings → Environment Variables.
# Referenced by /api/create-order.js. NEVER commit real values.
#
# Stripe is handled entirely by Base44 (it creates the checkout + runs its own
# webhook), so NO Stripe keys are needed here.

# --- Base44 (creates the order + Stripe checkout) ---
BASE44_FUNCTION_URL=https://washly-a922fe9f.base44.app/functions/createExternalOrder
EXTERNAL_API_KEY=your_shared_secret        # same value Base44 stores as EXTERNAL_API_KEY

# --- Telegram (optional owner alerts) ---
TELEGRAM_BOT_TOKEN=123456:ABC...           # from @BotFather
TELEGRAM_CHAT_ID=123456789                 # from @userinfobot
